# LLM API Configuration (OpenAI-compatible)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Comma-separated models players can choose from (Suspect's Brain dropdown)
LLM_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# 1 = canned replies, no API key needed.  0 = real AI (needs LLM_API_KEY above).
# Copy this file to .env and set MOCK_LLM=0 plus your key to play with the real model.
MOCK_LLM=1

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Flask debug mode (default 0 = off). Never enable in production.
FLASK_DEBUG=0
